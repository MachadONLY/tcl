{
  "name": "touchline-matchday",
  "version": "0.2.0",
  "private": true,
  "description": "Touchline Matchday — protótipo local da tela de partida",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --open",
    "dev:offline": "npm run sync:onboarding-assets && vite --host 0.0.0.0 --open",
    "build": "vite build",
    "build:offline": "npm run sync:onboarding-assets && vite build",
    "preview": "vite preview --host 0.0.0.0 --open",
    "sync:onboarding-assets": "node scripts/sync-onboarding-assets-offline.mjs",
    "sync:onboarding-assets:force": "node scripts/sync-onboarding-assets-offline.mjs --force",
    "sync:player-faces": "node scripts/sync-premier-league-faces.mjs",
    "test:mvp": "node tests/mvp-smoke.mjs",
    "test:live-rosters": "node tests/live-roster-smoke.mjs",
    "test:ui": "npm run build && node tests/ui-dom-smoke.mjs 1366 768 && node tests/ui-dom-smoke.mjs 1440 900"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
